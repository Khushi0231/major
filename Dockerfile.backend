# ============================================================
# DRAVIS Backend — Dockerfile (optimized for fast builds)
# No apt-get calls — avoids Mac Docker virtualization slowness
# ============================================================

FROM python:3.11-slim

WORKDIR /app

# Install Python deps first (cached layer)
# Split into 2 stages: lightweight deps first, then heavy ML deps with retries
COPY backend/requirements.txt ./requirements.txt

# Stage 1: Install lightweight deps (everything except torch/sentence-transformers)
RUN pip install --no-cache-dir --upgrade pip \
 && grep -v -E "^(torch|sentence-transformers|--extra-index)" requirements.txt > req-light.txt \
 && pip install --no-cache-dir -r req-light.txt

# Stage 2: Install ML deps with retries (torch download can be flaky in Docker)
RUN pip install --no-cache-dir --retries 10 --timeout 120 \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch sentence-transformers>=2.2.2

# Copy backend source
COPY backend/ ./backend/

# Create persistent data directories
RUN mkdir -p chroma_db dravis_data/uploads dravis_data/logs

EXPOSE 8000

# Healthcheck uses Python (no curl needed)
HEALTHCHECK --interval=20s --timeout=10s --start-period=40s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/').read()" || exit 1

# Start uvicorn
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
