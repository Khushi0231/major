# ============================================================
# DRAVIS Backend — Dockerfile
# FastAPI + uvicorn
# ============================================================

FROM python:3.11-slim AS backend

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (layer-cached unless requirements.txt changes)
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY backend/ ./backend/

# Empty __init__.py at root so `python -m backend.main` works
RUN touch __init__.py

# Create data directories
RUN mkdir -p chroma_db dravis_data/uploads dravis_data/logs

# Expose port
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=20s --timeout=10s --start-period=30s --retries=5 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start uvicorn (NOT flask!)
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
